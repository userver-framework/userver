#include <userver/utils/assert.hpp>
{% endif %}

namespace {{ namespace }} {

namespace {

USERVER_NAMESPACE::chaotic::openapi::client::Config MakeConfig(
    const USERVER_NAMESPACE::components::ComponentConfig& config,
    const USERVER_NAMESPACE::components::ComponentContext&{% if spec.uses_digest_security() %} context{% endif %}
) {
    auto cfg = USERVER_NAMESPACE::chaotic::openapi::client::ParseConfig(config, ClientImpl::kDefaultBaseUrl);
    {% if spec.uses_digest_security() %}
    const auto& secdist = context.FindComponent<USERVER_NAMESPACE::components::Secdist>().Get();
    const auto& digest_cfg = secdist.Get<USERVER_NAMESPACE::chaotic::openapi::client::DigestAuthSecdistConfig>();

    {% for scheme_name in spec.digest_scheme_names() %}
    {
        const auto [it, inserted] = cfg.digest_auth_credentials.emplace(
            "{{ scheme_name }}",
            digest_cfg.GetCredentialsOrThrow("{{ spec.client_name }}", "{{ scheme_name }}")
        );
        UINVARIANT(
            inserted,
            "Duplicate digest auth scheme '{{ scheme_name }}' for client '{{ spec.client_name }}'; "
            "scheme names must be unique — this is a chaotic-openapi codegen bug, please report it"
        );
    }
    {% endfor %}
    {% endif %}

    return cfg;
}

}  // namespace

{% filter indent(width=8, first=True) %}

Component::Component(
    const USERVER_NAMESPACE::components::ComponentConfig& config,
    const USERVER_NAMESPACE::components::ComponentContext& context
)
    : USERVER_NAMESPACE::components::ComponentBase(config, context),
      client_(
          MakeConfig(config, context),
          context.FindComponent<USERVER_NAMESPACE::components::HttpClient>().GetHttpClient()
      ) 
{
    if (config.HasMember("middlewares")) {
        const auto& mw_config = config["middlewares"];
        
        for (const auto& [name, config] : USERVER_NAMESPACE::formats::common::Items(mw_config)) {
            auto& factory = context.FindComponent<
                USERVER_NAMESPACE::chaotic::openapi::client::MiddlewareFactory>("chaotic-client-middleware-" + name);
            auto middleware = factory.Create(config);
            client_.RegisterMiddleware(middleware);
        }

        const auto& names = config["core-middlewares"].As<std::optional<std::vector<std::string>>>(std::nullopt);
        std::optional<std::vector<USERVER_NAMESPACE::utils::NotNull<USERVER_NAMESPACE::clients::http::MiddlewareBase*>>> core_middlewares;
        if (names) {
            core_middlewares.emplace();
            for (const auto& name : *names) {
                auto& component = context.FindComponent<
                    USERVER_NAMESPACE::clients::http::middlewares::ComponentBase>(name);
                core_middlewares->emplace_back(&component.GetMiddleware());
            }
        }
        client_.SetCoreMiddlewares(std::move(core_middlewares));
    }

    using Factories = USERVER_NAMESPACE::chaotic::openapi::server::dependencies::Factories;
    auto& factories = context.FindComponent<USERVER_NAMESPACE::components::Container<Factories>>().Get();
    factories.Register([&client = client_]() -> Client& { return client; });
}

Client& Component::GetClient() { return client_; }

USERVER_NAMESPACE::yaml_config::Schema Component::GetStaticConfigSchema() {
    std::string base_schema = R"(
type: object
description: OpenAPI HTTP client with middlewares
additionalProperties: false
properties:
    base-url:
        type: string
        description: Base URL for the API
    timeout-ms:
        type: integer
        description: Request timeout in milliseconds
        minimum: 1
    attempts:
        type: integer
        description: Maximum number of retry attempts
        minimum: 1
    middlewares:
        type: object
        description: Middlewares configuration
        additionalProperties: true
        properties: {}
)";

    return USERVER_NAMESPACE::yaml_config::MergeSchemas<USERVER_NAMESPACE::components::ComponentBase>(base_schema);
}

